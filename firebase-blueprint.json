{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "A cosmetic product available in the store.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Name of the product." },
        "description": { "type": "string", "description": "Detailed product description." },
        "price": { "type": "number", "description": "Price of the product." },
        "category": { "type": "string", "description": "Category ID or name." },
        "stock": { "type": "integer", "description": "Current inventory count." },
        "images": { "type": "array", "description": "List of image URLs." },
        "ingredients": { "type": "string", "description": "List of key ingredients." },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "price", "category", "stock"]
    },
    "Category": {
      "title": "Category",
      "description": "Product categories.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["name"]
    },
    "Order": {
      "title": "Order",
      "description": "A customer order.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "processing", "shipped", "delivered", "cancelled"] },
        "shippingAddress": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "items", "totalAmount", "status"]
    },
    "UserProfile": {
      "title": "User Profile",
      "description": "Extended user information.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "customer"] },
        "addresses": { "type": "array" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "products/{productId}": {
      "schema": "Product",
      "description": "Collection of cosmetic products."
    },
    "categories/{categoryId}": {
      "schema": "Category",
      "description": "Collection of product categories."
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of customer orders."
    },
    "users/{userId}": {
      "schema": "UserProfile",
      "description": "Collection of user profiles."
    }
  }
}
